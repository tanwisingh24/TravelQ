# Required on Vercel (production). Leave unset locally to use SQLite instead.
# Get this from Neon (neon.tech) or Vercel's own Postgres storage integration —
# it's a full Postgres connection string, e.g.:
#   postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Use the POOLED connection string (host usually contains "-pooler") since
# each serverless invocation opens its own connection.
DATABASE_URL=

# Used to sign JWTs. Set a long random value in Vercel's project settings —
# do NOT reuse the fallback dev value in production.
SECRET_KEY=
